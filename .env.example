# =================================================================
# Telegram Tools Configuration
# =================================================================

# Global application credentials (obtain from https://my.telegram.org).
# They cannot be supplied by users or changed from the web panel.
TG_API_ID=
TG_API_HASH=

# Web Dashboard Security
# Secret used for JWT signing and Fernet encryption. Use at least 32 random bytes.
APP_SECRET_KEY=
# Required master password for the web panel.
ADMIN_PASSWORD=

# Application Server
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Persistent data location used by the container.
DATA_DIR=/app/data
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
